---
layout: none
permalink: /search_index.json
---
[
{% assign all_items = "" | split: "" %}
{% assign all_items = all_items | concat: site.articles %}
{% assign all_items = all_items | concat: site.letters %}
{% assign all_items = all_items | concat: site.reviews %}
{% assign all_items = all_items | concat: site.reflections %}
{% assign all_items = all_items | concat: site.calls %}
{% assign all_items = all_items | concat: site.short_stories %}
{% assign all_items = all_items | concat: site.poetry %}
{% assign all_items = all_items | concat: site.dialogues %}
{% assign all_items = all_items | concat: site.satire %}
{% assign all_items = all_items | concat: site.nonfiction %}
{% assign all_items = all_items | concat: site.events %}
{% assign all_items = all_items | concat: site.diary %}
{% assign sorted = all_items | sort: "date" | reverse %}
{% assign first_item_written = false %}
{% for item in sorted %}
  {% if site.lang == 'en' and item.available_en == false %}{% continue %}{% endif %}
  {% if site.lang == 'ur' and item.available_ur == false %}{% continue %}{% endif %}
  {% if first_item_written %},{% endif %}
  {% assign first_item_written = true %}
  {
    "title_en": {{ item.title_en | jsonify }},
    "title_ur": {{ item.title_ur | jsonify }},
    "description_en": {{ item.description_en | jsonify }},
    "description_ur": {{ item.description_ur | jsonify }},
    "url_en": "{{ site.baseurl }}/en{{ item.url }}",
    "url_ur": "{{ site.baseurl }}/ur{{ item.url }}",
    "date": "{{ item.date | date: '%Y-%m-%d' }}",
    "type_en": "{% case item.collection.label %}{% when 'articles' %}Article{% when 'letters' %}Letter{% when 'diary' %}Teaching Diary{% when 'reviews' %}Review{% when 'reflections' %}Reflection{% when 'short_stories' %}Short Story{% when 'poetry' %}Poetry{% when 'dialogues' %}Dialogue{% when 'satire' %}Satire{% when 'nonfiction' %}Nonfiction{% when 'events' %}Event{% when 'calls' %}Call{% endcase %}",
    "type_ur": "{% case item.collection.label %}{% when 'articles' %}مضمون{% when 'letters' %}خط{% when 'diary' %}تدریسی ڈائری{% when 'reviews' %}جائزہ{% when 'reflections' %}عکاسی{% when 'short_stories' %}مختصر کہانی{% when 'poetry' %}شاعری{% when 'dialogues' %}مکالمہ{% when 'satire' %}طنزیہ تحریر{% when 'nonfiction' %}نان فکشن{% when 'events' %}تقریب{% when 'calls' %}دعوت{% endcase %}",
    "content": {{ item.content | strip_html | normalize_whitespace | jsonify }}
  }
{% endfor %}
]
